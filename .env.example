POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_DB=postgres
POSTGRES_STORAGE=/path/postgres-storage

MONGO_USER=root
MONGO_PASSWORD=root
MONGO_STORAGE=/path/mongo-storage

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_STORAGE=/path/minio-storage

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=mysql
MYSQL_USER=your_username
MYSQL_PASSWORD=your_password
MYSQL_STORAGE=/path/mysql-storage
MARIADB_STORAGE=/path/mariadb-storage

CONSUL_STORAGE=/path/consul-storage

MIRTH_STORAGE=/path/mirth-storage

ORDS_DATABASE_HOST=your_oracle_host
ORDS_DATABASE_PORT=1521
ORDS_DATABASE_NAME=your_service_name
