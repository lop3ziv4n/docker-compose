ORDS_DATABASE_PASSWORD=your_password
ORDS_PATH=/ords
ORDS_DATABASE_POOL_INITIAL_SIZE=5
ORDS_DATABASE_POOL_MAX_SIZE=20
ORDS_STORAGE=/path/ords-storage

RABBITMQ_DEFAULT_USER=your_username
RABBITMQ_DEFAULT_PASS=your_password
RABBITMQ_STORAGE=/path/rabbitmq-storage

RANCHER_VIRTUAL_HOST: rancher.example.com
RANCHER_VIRTUAL_PORT: 80
RANCHER_LETSENCRYPT_HOST: rancher.example.com
RANCHER_LETSENCRYPT_EMAIL: email@example.com

REDIS_STORAGE=/path/redis-storage

WATCHTOWER_REPO_USER=repo_username
WATCHTOWER_REPO_PASS=repo_password
WATCHTOWER_CONTAINER_NAME=container-name
